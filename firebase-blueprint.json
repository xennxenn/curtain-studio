{
  "entities": {
    "Job": {
      "title": "Job",
      "description": "Represents a curtain project/job ordered by a customer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "customerName"]
    },
    "WindowItem": {
      "title": "WindowItem",
      "description": "Represents a window item configured within a curtain project/job.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "name": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "solidFabricName": { "type": "string" },
        "sheerFabricName": { "type": "string" },
        "fabricImageBase64": { "type": "string" },
        "sheerImageBase64": { "type": "string" }
      },
      "required": ["id", "jobId"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Represents an employee/staff member in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "designer", "installer"] },
        "aiQuota": { "type": "number" },
        "aiUsed": { "type": "number" }
      },
      "required": ["id", "name", "username", "role"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Represents the global system settings and materials database.",
      "type": "object",
      "properties": {
        "curtainStyles": { "type": "array", "items": { "type": "string" } },
        "patterns": { "type": "array", "items": { "type": "string" } },
        "tracks": { "type": "array", "items": { "type": "string" } },
        "accessories": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Collection of all jobs."
    },
    "/windows/{windowId}": {
      "schema": "WindowItem",
      "description": "Collection of all window configurations."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Collection of employee credentials and AI quotas."
    },
    "/settings/{settingsDocId}": {
      "schema": "Settings",
      "description": "Collection of settings documents (global configurations and sub-arrays)."
    }
  }
}
