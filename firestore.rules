rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
      match /{subcol}/{subDocId} {
        allow read, write: if true;
      }
    }
    match /jobs/{jobId} {
      allow read, write: if true;
    }
    match /windows/{windowId} {
      allow read, write: if true;
    }
    match /employees/{employeeId} {
      allow read, write: if true;
    }
  }
}

